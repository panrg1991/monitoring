[Unit]
Description=MES Monitor API Service
Documentation=file://__APP_DIR__/deploy/README.md
After=network.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__APP_DIR__
Environment=NODE_ENV=production
Environment=PORT=__PORT__
Environment=TZ=Asia/Shanghai
ExecStart=__NODE_BIN__ server.js
Restart=always
RestartSec=5
StandardOutput=append:__APP_DIR__/server.stdout.log
StandardError=append:__APP_DIR__/server.stderr.log

[Install]
WantedBy=multi-user.target

# 说明：本文件是模板，占位符 __APP_DIR__ / __RUN_USER__ / __NODE_BIN__ / __PORT__
#       由 deploy/linux/install.sh 自动替换后写入 /etc/systemd/system/mesmonitor.service。
#       手工部署时可复制到 /etc/systemd/system/ 并自行改好路径，然后：
#         systemctl daemon-reload && systemctl enable --now mesmonitor
